<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shepherd</groupId>
        <artifactId>shepherd-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../shepherd-parent</relativePath>
    </parent>

    <artifactId>shepherd-spring-boot-starter-oss</artifactId>
    <!-- 无源码的依赖聚合器。不声明 packaging（即 jar）：packaging=pom 只产出 .pom，
         下游一条普通 <dependency> 解析不到 jar；Spring Boot 官方 starter 同此。 -->
    <name>shepherd-spring-boot-starter-oss</name>
    <description>对象存储：S3 兼容实现（MinIO / R2 / S3 / 阿里云 S3 兼容模式）</description>

    <dependencies>
        <dependency>
            <groupId>com.shepherd</groupId>
            <artifactId>shepherd-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apache-client</artifactId>
            <!-- 排除 commons-logging：版本收敛而非类冲突，httpclient 4.x 传递进来的另一版本 -->
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
