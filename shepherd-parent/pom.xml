<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.shepherd</groupId>
    <artifactId>shepherd-parent</artifactId>
    <version>0.4.0</version>
    <packaging>pom</packaging>

    <name>shepherd-parent</name>
    <description>业务项目继承的父 pom：版本收敛 + 构建约定</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.shepherd</groupId>
                <artifactId>shepherd-dependencies</artifactId>
                <!-- 必须写字面量版本，不能用 ${project.version}。
                     本段会被下游业务项目通过继承拿到，而继承时的属性插值发生在
                     「子 pom 的上下文」——${project.version} 会解析成业务项目自己的版本
                     （如 backend 的 0.0.1），导致 Maven 去找不存在的
                     com.shepherd:shepherd-dependencies:pom:0.0.1。
                     framework 自身的 reactor 里所有模块同版本，会掩盖这个 bug。
                     升版本时这里和上面的 <version> 要一起改：用 mvn versions:set -DnewVersion=...
                     升版本，其 processDependencyManagement 默认为 true，会连这处一起改；
                     手改 <version> 时两处必须同动，不能只改一处。 -->
                <version>0.4.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- lombok 必须排在其余处理器之前：@Data/@Getter 生成的方法要先存在，
                             configuration-processor 与 mapstruct 才扫描得到。
                             不写 version：compiler 3.12.0+ 从 dependencyManagement 解析。 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <!-- 每个 *IT 类使用独立 JVM fork：多个 Spring Boot 测试类在同一 JVM 内顺序创建/销毁
                             各自的 Testcontainers（Postgres+Redis）时，观测到偶发的容器端口连接被拒绝
                             （HikariPool 在第二个及以后的类中超时/connection refused），怀疑是宿主 Docker
                             网络层（OrbStack）端口回收与下一容器启动之间的竞争。forkCount=1 + reuseForks=false
                             让每个 *IT 类独占一个全新 JVM/容器生命周期，规避该竞争，多次验证稳定通过。 -->
                        <forkCount>1</forkCount>
                        <reuseForks>false</reuseForks>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 源码 jar：下游 IDE 里能直接跳进实现。
                 副作用：继承本 parent 的业务应用也会产出一个 sources jar，无害。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- javadoc 打包较慢，只在发布时跑：mvn deploy -P release -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/shepherd-yun/shepherd-framework</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/shepherd-yun/shepherd-framework</url>
        </snapshotRepository>
    </distributionManagement>
</project>
