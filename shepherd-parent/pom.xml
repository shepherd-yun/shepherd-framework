<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.shepherdyun</groupId>
    <artifactId>shepherd-parent</artifactId>
    <version>0.5.0-RC1</version>
    <packaging>pom</packaging>

    <name>shepherd-parent</name>
    <description>业务项目继承的父 pom：版本收敛 + 构建约定</description>
    <!-- 元数据必须在这里重新声明：不写的话本框架各模块会从 spring-boot-starter-parent
         继承 Spring 官方的 url/developers/scm，Central 校验能过但信息全是错的。
         append.path=false 让子模块原样继承，不拼成 .../shepherd-framework/shepherd-common。 -->
    <url>https://github.com/shepherd-yun/shepherd-framework</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>shepherd-yun</id>
            <name>yun</name>
            <url>https://github.com/shepherd-yun</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/shepherd-yun/shepherd-framework.git</connection>
        <developerConnection>scm:git:git@github.com:shepherd-yun/shepherd-framework.git</developerConnection>
        <url>https://github.com/shepherd-yun/shepherd-framework</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.shepherdyun</groupId>
                <artifactId>shepherd-dependencies</artifactId>
                <!-- 必须写字面量版本，不能用 ${project.version}。
                     本段会被下游业务项目通过继承拿到，而继承时的属性插值发生在
                     「子 pom 的上下文」——${project.version} 会解析成业务项目自己的版本
                     （如 backend 的 0.0.1），导致 Maven 去找不存在的
                     com.shepherdyun:shepherd-dependencies:pom:0.0.1。
                     framework 自身的 reactor 里所有模块同版本，会掩盖这个 bug。
                     升版本时这里和上面的 <version> 要一起改：用 mvn versions:set -DnewVersion=...
                     升版本，其 processDependencyManagement 默认为 true，会连这处一起改；
                     手改 <version> 时两处必须同动，不能只改一处。 -->
                <version>0.5.0-RC1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- lombok 必须排在其余处理器之前：@Data/@Getter 生成的方法要先存在，
                             configuration-processor 与 mapstruct 才扫描得到。
                             不写 version：compiler 3.12.0+ 从 dependencyManagement 解析。 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <!-- 每个 *IT 类使用独立 JVM fork：多个 Spring Boot 测试类在同一 JVM 内顺序创建/销毁
                             各自的 Testcontainers（Postgres+Redis）时，观测到偶发的容器端口连接被拒绝
                             （HikariPool 在第二个及以后的类中超时/connection refused），怀疑是宿主 Docker
                             网络层（OrbStack）端口回收与下一容器启动之间的竞争。forkCount=1 + reuseForks=false
                             让每个 *IT 类独占一个全新 JVM/容器生命周期，规避该竞争，多次验证稳定通过。 -->
                        <forkCount>1</forkCount>
                        <reuseForks>false</reuseForks>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 源码 jar：下游 IDE 里能直接跳进实现。
                 副作用：继承本 parent 的业务应用也会产出一个 sources jar，无害。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- javadoc 打包较慢，只在发布时跑：mvn deploy -P release -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 发布本框架到 Maven Central：mvn deploy -P central（含 javadoc，无需再叠加 release）。
             下游业务项目继承本 parent 也会继承此 profile，但不显式 -P central 就不会触发；
             签名与 Central 上传因此与上面下游也会用到的 release 分开，而不是塞进 release。 -->
        <profile>
            <id>central</id>
            <properties>
                <!-- 薄 starter 没有源码，source/javadoc 插件都会直接跳过不产出 jar，
                     但 Central 要求非 pom 打包的制品必须带 -sources.jar 与 -javadoc.jar。
                     薄 starter 把它置为 package，由下面的 maven-jar-plugin 补两个空 jar——
                     Spring Boot 官方薄 starter 发到 Central 的也是空 jar。
                     用 phase 而不是 skip 开关：maven-jar-plugin 没有 skip 参数，写了会被静默忽略。 -->
                <shepherd.empty-docs-jar.phase>none</shepherd.empty-docs-jar.phase>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>empty-sources-jar</id>
                                <phase>${shepherd.empty-docs-jar.phase}</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.build.directory}/empty-docs</classesDirectory>
                                    <skipIfEmpty>false</skipIfEmpty>
                                </configuration>
                            </execution>
                            <execution>
                                <id>empty-javadoc-jar</id>
                                <phase>${shepherd.empty-docs-jar.phase}</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.build.directory}/empty-docs</classesDirectory>
                                    <skipIfEmpty>false</skipIfEmpty>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
