<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shepherd</groupId>
        <artifactId>shepherd-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../shepherd-parent</relativePath>
    </parent>

    <artifactId>shepherd-spring-boot-starter-excel</artifactId>
    <name>shepherd-spring-boot-starter-excel</name>
    <description>Excel 导入导出：同步导出、下拉模板、分批导入、异步任务</description>

    <dependencies>
        <dependency>
            <groupId>com.shepherd</groupId>
            <artifactId>shepherd-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.idev.excel</groupId>
            <artifactId>fastexcel</artifactId>
        </dependency>
        <!-- 异步任务态存 Redis；同步导入导出不需要，但异步层缺它会 fail-fast -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>
</project>
