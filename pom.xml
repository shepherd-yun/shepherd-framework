<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.shepherd</groupId>
    <artifactId>shepherd-framework</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>shepherd-framework</name>
    <description>后端工程地基：统一响应契约、全局异常、TraceId、MyBatis-Plus 审计、JWT 认证、对象存储、单号生成、Excel 导入导出</description>
    <url>https://github.com/shepherd-yun/shepherd-spring-boot-starter</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>shepherd-yun</id>
            <name>yun</name>
            <url>https://github.com/shepherd-yun</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/shepherd-yun/shepherd-spring-boot-starter.git</connection>
        <developerConnection>scm:git:git@github.com:shepherd-yun/shepherd-spring-boot-starter.git</developerConnection>
        <url>https://github.com/shepherd-yun/shepherd-spring-boot-starter</url>
        <tag>HEAD</tag>
    </scm>

    <!-- 聚合用，只管本仓库的 reactor 构建。下游继承的是 shepherd-parent，不是这个。 -->
    <modules>
        <module>shepherd-dependencies</module>
        <module>shepherd-parent</module>
        <module>shepherd-spring-boot-autoconfigure</module>
    </modules>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/shepherd-yun/shepherd-spring-boot-starter</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/shepherd-yun/shepherd-spring-boot-starter</url>
        </snapshotRepository>
    </distributionManagement>
</project>
