<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.shepherdyun</groupId>
    <artifactId>shepherd-framework</artifactId>
    <version>0.5.0-RC1</version>
    <packaging>pom</packaging>

    <name>shepherd-framework</name>
    <description>后端工程地基：统一响应契约、全局异常、TraceId、MyBatis-Plus 审计、JWT 认证、对象存储、单号生成、Excel 导入导出</description>
    <url>https://github.com/shepherd-yun/shepherd-framework</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>shepherd-yun</id>
            <name>yun</name>
            <url>https://github.com/shepherd-yun</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/shepherd-yun/shepherd-framework.git</connection>
        <developerConnection>scm:git:git@github.com:shepherd-yun/shepherd-framework.git</developerConnection>
        <url>https://github.com/shepherd-yun/shepherd-framework</url>
        <tag>HEAD</tag>
    </scm>

    <!-- 聚合用，只管本仓库的 reactor 构建。下游继承的是 shepherd-parent，不是这个。 -->
    <modules>
        <module>shepherd-dependencies</module>
        <module>shepherd-parent</module>
        <module>shepherd-common</module>
        <module>shepherd-common-mybatis</module>
        <module>shepherd-spring-boot-autoconfigure</module>
        <module>shepherd-spring-boot-starter-web</module>
        <module>shepherd-spring-boot-starter-mybatis</module>
        <module>shepherd-spring-boot-starter-security</module>
        <module>shepherd-spring-boot-starter-oss</module>
        <module>shepherd-spring-boot-starter-excel</module>
    </modules>

    <profiles>
        <!-- 发布到 Maven Central：mvn deploy -P central。
             同名 profile 在 shepherd-dependencies 与 shepherd-parent 里各有一份——
             三者继承链互不相通（本 pom 与 BOM 都不继承 shepherd-parent），
             而 central-publishing 插件要求 reactor 里每个模块都由它接管 deploy，
             少一处，那个模块就会回落到 maven-deploy-plugin 并因没有 distributionManagement 而失败。 -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
