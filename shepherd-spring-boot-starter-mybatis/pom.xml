<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shepherdyun</groupId>
        <artifactId>shepherd-parent</artifactId>
        <version>0.5.0</version>
        <relativePath>../shepherd-parent</relativePath>
    </parent>

    <artifactId>shepherd-spring-boot-starter-mybatis</artifactId>
    <!-- 无源码的依赖聚合器。不声明 packaging（即 jar）：packaging=pom 只产出 .pom，
         下游一条普通 <dependency> 解析不到 jar；Spring Boot 官方 starter 同此。 -->
    <name>shepherd-spring-boot-starter-mybatis</name>
    <description>MyBatis-Plus 地基：审计字段自动填充、分页插件、MpPages 转换</description>

    <properties>
        <!-- 无源码，发 Central 时由 shepherd-parent 的 central profile 补空 sources/javadoc jar -->
        <shepherd.empty-docs-jar.phase>package</shepherd.empty-docs-jar.phase>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.shepherdyun</groupId>
            <artifactId>shepherd-spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shepherdyun</groupId>
            <artifactId>shepherd-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 不可省：自 3.5.9 起 PaginationInnerInterceptor 被拆到本工件 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
    </dependencies>
</project>
